# Konfigurasi produksi BELAJAR CPNS (cPanel). File asli: ~/public/belajarcpns.web.id/_app/.env (chmod 600, tidak di Git).
API_PORT=47391
APP_ENV=production
# Ganti GANTI_PASSWORD_DB dengan password user PostgreSQL tanjunak_apriprogram.
DATABASE_URL='postgres://tanjunak_apriprogram:GANTI_PASSWORD_DB@localhost:5432/tanjunak_belajarcpns_db?sslmode=disable'
JWT_SECRET='__JWT_SECRET__'
CORS_ORIGINS=https://belajarcpns.web.id,https://www.belajarcpns.web.id
COOKIE_SECURE=true
UPLOAD_DIR=./data/uploads
SITE_URL=https://belajarcpns.web.id
# true = isi data contoh (akun admin demo, soal, paket) sekali saat API start. Lihat docs/DEPLOY-CPANEL.md.
SEED=false
