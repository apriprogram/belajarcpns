# Konfigurasi API saat dijalankan manual (tanpa Docker): go run ./cmd/api
# Muat ke shell, mis. Linux/Mac: set -a; . ./.env; set +a
# PowerShell: Get-Content .env | ? { $_ -match '^\s*[^#].*=' } | % { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim()) }
PORT=8080
DATABASE_URL=postgres://bisapns:bisapns@localhost:5432/bisapns?sslmode=disable
JWT_SECRET=dev-secret-ganti-di-produksi-minimal-32-karakter
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
COOKIE_SECURE=false
SEED=false
