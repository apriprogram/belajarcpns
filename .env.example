# =====================================================================
# BISA-PNS — variabel lingkungan untuk Docker Compose (salin ke .env)
#   cp .env.example .env        (Windows: copy .env.example .env)
# =====================================================================

# ---- Database (PostgreSQL 16) ----
POSTGRES_USER=bisapns
POSTGRES_PASSWORD=bisapns            # PRODUKSI: ganti dengan password kuat
POSTGRES_DB=bisapns

# ---- API (Go) ----
# Minimal 32 karakter acak. Contoh membuat: openssl rand -base64 48
JWT_SECRET=dev-secret-ganti-di-produksi-minimal-32-karakter
APP_ENV=development                  # development | production
CORS_ORIGINS=http://localhost:3000   # pisahkan dengan koma bila lebih dari satu
SEED=true                            # true = isi data demo saat API start (aman diulang)

# ---- Port host (docker-compose.yml / lokal) ----
WEB_PORT=3000
API_PORT=8080
DB_PORT=5432

# ---- Produksi (docker-compose.prod.yml) ----
DOMAIN=bisapns.example.com           # domain yang A-record-nya mengarah ke server
ACME_EMAIL=admin@example.com         # email untuk Let's Encrypt (gunakan email asli)
BACKUP_TIME=02:00                    # jam backup harian (WIB)
BACKUP_RETENTION_DAYS=14
